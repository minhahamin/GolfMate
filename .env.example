# docker-compose가 postgres 컨테이너를 초기화할 때 사용하는 자격증명.
# 실제 값은 .env 파일에 넣고 절대 커밋하지 않는다.
POSTGRES_USER=golfmate
POSTGRES_PASSWORD=golfmate
POSTGRES_DB=golfmate
POSTGRES_PORT=5432

# 8000/5173은 로컬에 다른 프로젝트(Vite/FastAPI 기본 포트)가 떠 있으면 흔히 충돌하므로
# 기본값을 비표준 포트로 잡는다. 필요하면 자유롭게 바꿔도 된다.
BACKEND_PORT=8010
FRONTEND_PORT=5180
