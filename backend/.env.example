# PostgreSQL 연결 문자열
# docker-compose 로 실행할 때는 host가 서비스명(db)이 되고,
# 로컬에서 backend만 단독으로 띄울 때는 localhost로 바꿔서 사용한다.
DATABASE_URL=postgresql+psycopg2://golfmate:golfmate@db:5432/golfmate

# 프론트엔드 개발 서버 Origin (CORS 허용 목록, 콤마로 구분)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# 실행 환경 (local / docker / production)
APP_ENV=docker
