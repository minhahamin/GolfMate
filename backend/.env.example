# PostgreSQL 연결 문자열
# docker-compose 로 실행할 때는 host가 서비스명(db)이 되고,
# 로컬에서 backend만 단독으로 띄울 때는 localhost로 바꿔서 사용한다.
DATABASE_URL=postgresql+psycopg2://golfmate:golfmate@db:5432/golfmate

# 프론트엔드 개발 서버 Origin (CORS 허용 목록, 콤마로 구분)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# 실행 환경 (local / docker / production)
APP_ENV=docker

# JWT 서명 키 — 반드시 운영 환경에서는 무작위 값으로 교체한다.
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
# Access Token 만료(분). 기본 1440분(24시간) — 데모 편의를 위한 값, 운영에서는 더 짧게.
JWT_EXPIRE_MINUTES=1440

# AI Coach용 LLM — OpenRouter (OpenAI 호환 API). https://openrouter.ai/keys 에서 발급.
# 무료 모델을 쓰면 비용 없이 개발할 수 있지만, 무료 모델은 업스트림 사정으로 바뀌거나
# rate-limit이 걸릴 수 있으니 필요하면 OPENROUTER_MODEL을 다른 :free 모델로 교체한다.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
